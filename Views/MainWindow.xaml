<Window x:Class="ExcelMaker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExcelMaker" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        Closing="Window_Closing">
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" Background="#2B2B2B" Padding="16,10">
            <DockPanel>
                <TextBlock Text="ExcelMaker" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentUser, StringFormat='操作员: {0}'}" Foreground="#999" FontSize="12"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="退出" Style="{StaticResource BtnDanger}"
                        Command="{Binding ExitAppCommand}"/>
            </DockPanel>
        </Border>

        <!-- 功能区 -->
        <Border DockPanel.Dock="Top" Background="White" Margin="8" Padding="12" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="功能" FontWeight="Bold" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="导入更新库位名称" Style="{StaticResource BtnSuccess}" Width="180" Height="36"
                            Command="{Binding ImportStockNameCommand}"/>
                    <TextBlock Text="取 Excel 第一个工作表，逐行找表头后 MERGE 到 FACTORY_STOCK_NAME"
                               Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="年月：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding SelectedYearMonth}" Width="120" VerticalAlignment="Center"
                                DisplayDateStart="2020-01-01"/>
                    <TextBlock Text="（默认当月，用于取复盘人）" Foreground="#666" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Content="处理库存明细 Excel" Style="{StaticResource BtnPrimary}" Margin="16,0,0,0"
                            Width="180" Height="36" Command="{Binding ProcessInventoryCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#107C10" FontSize="12" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Background="#1E1E1E" Margin="8,0,8,8" Padding="8" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="日志" Foreground="#CCC" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                         Foreground="#CCC" FontSize="12" FontFamily="Consolas"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
